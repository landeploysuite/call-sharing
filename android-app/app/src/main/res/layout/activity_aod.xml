<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Anti-burn-in shifting container -->
    <LinearLayout
        android:id="@+id/aod_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Brand Watermark Logo -->
        <ImageView
            android:id="@+id/iv_aod_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.85"
            android:src="@drawable/croped"
            android:contentDescription="CallShare AOD Logo" />

        <!-- Minimalist Ambient Clock (1 FPS) -->
        <TextView
            android:id="@+id/text_aod_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:text="12:00"
            android:textColor="@color/aod_clock_white"
            android:textSize="80sp" />

        <TextView
            android:id="@+id/text_aod_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mon, Jan 1"
            android:textColor="@color/aod_muted_gray"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_aod_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="@color/aod_clock_white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_aod_mesh_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="● P2P LAN Mesh Active"
                android:textColor="@color/aod_mesh_green"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Dynamic Incoming Call Overlay (30 FPS when active) -->
        <LinearLayout
            android:id="@+id/layout_incoming_call"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@color/dark_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incoming Relayed Call"
                android:textColor="@color/aod_accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_caller_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Abhay SIM"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_caller_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="+1 (555) 019-2834"
                android:textColor="@color/aod_muted_gray"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_aod_reject"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/call_reject_red"
                    android:text="@string/reject_call"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_aod_answer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/call_answer_green"
                    android:text="@string/answer_call"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
