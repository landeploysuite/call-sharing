<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_surface"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Pane: Info & Peers -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <!-- Brand Header Bar with Official Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_app_logo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/croped"
                    android:contentDescription="CallShare P2P Brand Logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_title"
                        android:textColor="@color/aod_accent_cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Offline LAN Telephony • Universal AOD"
                        android:textColor="@color/text_telemetry_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Persistent Boot Diagnostics & Safe Mode Gate -->
            <LinearLayout
                android:id="@+id/layout_boot_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/dark_card"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/text_boot_checkpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Boot Diagnostic: Initializing..."
                    android:textColor="@color/cyan_opus_mesh"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_safe_mode_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/crimson_drop"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_safe_mode_resume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/crimson_drop"
                    android:text="Resume Startup (Manual Safe Retry)"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_local_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/dark_card"
                android:padding="12dp"
                android:textColor="@color/aod_clock_white"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Offline Wi-Fi Peers (Auto-Discovered)"
                android:textColor="@color/aod_mesh_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_peers_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/dark_card"
                android:minHeight="80dp"
                android:padding="12dp"
                android:text="@string/mesh_status_searching"
                android:textColor="@color/aod_clock_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Right Pane: Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_refresh_peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/dark_card"
                android:text="Refresh Peer Mesh"
                android:textColor="@color/aod_accent_cyan" />

            <Button
                android:id="@+id/btn_launch_aod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/aod_accent_cyan"
                android:text="@string/launch_aod"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_set_default_dialer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/dark_card"
                android:text="@string/set_companion_role"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/edit_dial_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/dark_card"
                android:hint="@string/dial_hint"
                android:inputType="phone"
                android:minHeight="44dp"
                android:padding="10dp"
                android:textColor="@color/aod_clock_white"
                android:textColorHint="@color/text_telemetry_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_direct_call"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/aod_mesh_green"
                    android:text="@string/direct_p2p_call"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_call_peer_sim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/aod_accent_cyan"
                    android:text="@string/call_via_peer_sim"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/dark_card"
                android:text="Settings &amp; AOD Studio"
                android:textColor="@color/cyan_opus_mesh" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
