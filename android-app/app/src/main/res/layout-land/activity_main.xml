<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_surface"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Pane: Info & Peers -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title"
                android:textColor="@color/aod_accent_cyan"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_local_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/dark_card"
                android:padding="12dp"
                android:textColor="@color/aod_clock_white"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Offline Wi-Fi Peers (Auto-Discovered)"
                android:textColor="@color/aod_mesh_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_peers_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/dark_card"
                android:minHeight="80dp"
                android:padding="12dp"
                android:text="@string/mesh_status_searching"
                android:textColor="@color/aod_clock_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Right Pane: Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_refresh_peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/dark_card"
                android:text="Refresh Peer Mesh"
                android:textColor="@color/aod_accent_cyan" />

            <Button
                android:id="@+id/btn_launch_aod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/aod_accent_cyan"
                android:text="@string/launch_aod"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_set_default_dialer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/dark_card"
                android:text="@string/set_companion_role"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_simulate_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/dark_card"
                android:text="@string/simulate_incoming_call"
                android:textColor="@color/aod_mesh_green" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
